# =============================================================================
# F3-Pipeline v1.2 — .gitignore
# =============================================================================
# Ziel: Repository enthaelt ausschliesslich Code, Konfiguration und
# Dokumentation. Daten, Outputs und Cache-Artefakte bleiben lokal.
# =============================================================================

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
.Python
.installed.cfg

# --- Virtuelle Umgebungen --------------------------------------------------
.venv/
venv/
env/
ENV/

# --- Jupyter / IDEs --------------------------------------------------------
.ipynb_checkpoints/
.vscode/
.idea/
*.swp
*.swo

# --- Tests / Coverage ------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# --- Pipeline-Outputs (werden lokal regeneriert) ---------------------------
output_phase1/
output_phase2/
output_cross_phase/
output_cross_phase*/
output_sensitivity/
logs/
*.log

# --- Generierte LaTeX-Tabellenfragmente (Schritt 2c) -----------------------
citation_topic_profile_appendix_rows.tex
citation_topic_profile_rows.tex

# --- Modell- und Embedding-Caches ------------------------------------------
*.pkl
*.joblib
*.npz
embeddings_cache/
sbert_cache/

# --- Rohdaten (lizenzpflichtig, nicht im Repo) -----------------------------
data/
*.csv
*.tsv
*.xlsx
*.parquet
# Ausnahme: synthetische Demo-Daten und Testfixtures
!data/synthetic_demo.csv
!tests/fixtures/*.csv

# --- Konfig-Overrides (lokal) ----------------------------------------------
config.local.py
.env
.env.*

# --- Betriebssystem --------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
ws_topic_tables.tex
figures_ws/
figures_paper/
figures_rp/
supplement_rp/

# --- Pipeline-Outputs, allgemein (ergaenzt 12.09.2026) ---------------------
# Ersetzt die Einzelnennungen weiter oben: Jeder neue output_-Ordner ist damit
# von vornherein erfasst. Bewusst mit Stern und nicht als Ordner geschrieben,
# denn in ein ausgeschlossenes Verzeichnis steigt git nicht hinein und die
# Ausnahme darunter griffe nicht.
output_*/*

# Belegt die Phasengrenzen-Zeile in Supplement-Tabelle S6 und Abbildung S16 und
# gehoert deshalb als einziger Output ins Repo.
!output_phase_boundary/phase_boundary_stability.json

# Erfasst war bisher nur *.npz. Die Label-Arrays sind dokumentweise
# Clusterzuordnungen und bleiben wie topic_assignments.csv lokal.
*.npy
